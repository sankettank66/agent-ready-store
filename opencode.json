{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--categoryExperimentalWebmcp",
        "--chromeArg=--enable-features=WebMCP"
      ],
      "enabled": true
    }
  }
}
